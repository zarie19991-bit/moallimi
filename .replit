modules = ["nodejs-20", "web", "python-base-3.13"]

[nix]
channel = "stable-25_05"
packages = ["freetype", "gumbo", "harfbuzz", "jbig2dec", "libjpeg_turbo", "mupdf", "openjpeg", "swig", "xcbuild"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = """
python3 -c $'import http.server,pathlib,urllib.parse
ROOT=pathlib.Path.cwd().resolve()
ALLOWED={s.strip() for s in (ROOT/\"production-files.txt\").read_text().splitlines() if s.strip() and not s.lstrip().startswith(\"#\")}
ASSETS=(ROOT/\"question-bank/assets\").resolve()
class Safe(http.server.SimpleHTTPRequestHandler):
    def translate_path(self,url):
        raw=urllib.parse.unquote(urllib.parse.urlsplit(url).path).lstrip(\"/\") or \"index.html\"
        target=(ROOT/raw).resolve()
        try: rel=target.relative_to(ROOT).as_posix()
        except ValueError: return str(ROOT/\"__blocked__\")
        if target.is_file() and (rel in ALLOWED or ASSETS in target.parents): return str(target)
        return str(ROOT/\"__blocked__\")
http.server.ThreadingHTTPServer((\"0.0.0.0\",5000),Safe).serve_forever()'"""
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80
